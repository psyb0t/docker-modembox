{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.psyb0t/modembox",
  "title": "ModemBox",
  "description": "Control USB cellular modems, SMS, calls and audio over MCP.",
  "version": "0.0.0",
  "repository": {
    "url": "https://github.com/psyb0t/docker-modembox",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "oci",
      "identifier": "docker.io/psyb0t/modembox:latest",
      "runtimeHint": "docker",
      "transport": {
        "type": "streamable-http",
        "url": "http://localhost:8000/mcp"
      }
    }
  ]
}
