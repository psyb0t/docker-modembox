{
  "name": "@psyb0t/modembox",
  "version": "0.0.0",
  "mcpName": "io.github.psyb0t/modembox",
  "description": "Streamable HTTP MCP bridge for a self-hosted ModemBox.",
  "type": "module",
  "bin": {
    "modembox-mcp": "bin/cli.js"
  },
  "files": [
    "bin",
    "index.js",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "license": "AGPL-3.0-only",
  "author": "psyb0t",
  "homepage": "https://github.com/psyb0t/docker-modembox",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/psyb0t/docker-modembox.git"
  },
  "bugs": {
    "url": "https://github.com/psyb0t/docker-modembox/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "modembox",
    "cellular",
    "sms",
    "voice",
    "openclaw",
    "ai-agent"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "mcp-remote": "0.1.38"
  },
  "publishConfig": {
    "access": "public"
  },
  "openclaw": {
    "extensions": [
      "./index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.3.24-beta.2"
    },
    "build": {
      "openclawVersion": "2026.3.24-beta.2"
    }
  }
}
