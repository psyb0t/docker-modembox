MODEMBOX_TOKEN=REPLACE_ME
# Set to true only for an instance you want to run without token authentication.
# MODEMBOX_DISABLE_AUTH=false

# Advanced Docker overrides. Supported USB layouts are discovered automatically.
# MODEMBOX_DEVICES=[]
# MODEMBOX_ALLOW_RAW_AT=false
# MODEMBOX_DATA_DIR=/data
# MODEMBOX_WEB_DIR=/app/ui

# Hardware SMS reply test only. Set these in .env.test.
# MODEMBOX_TEST_NUMBER=+15550100123
# MODEMBOX_TEST_PIN=
# MODEMBOX_TEST_SMS_TEXT=TEST1
